                    { nama: "Rayhan Syahputra", peran: "Anggota" },
                    { nama: "Fikri Haikal", peran: "Anggota" },
                    { nama: "Bagas Saputra", peran: "Anggota" }
                ],
                tugas: [
                    { id: "rab-1", teks: "Menyikat lantai tempat wudhu agar tidak licin", selesai: true },
                    { id: "rab-2", teks: "Membersihkan bak mandi dan mengecek kran air", selesai: true },
                    { id: "rab-3", teks: "Mengangkat sampah plastik dari saluran drainase", selesai: true },
                    { id: "rab-4", teks: "Mengisi ulang sabun cuci tangan di wastafel", selesai: false }
                ]
            },
            kamis: {
                hari: "Kamis",
                icon: "🍽️",
                kelompok: "Kelompok Ali bin Abi Thalib",
                lokasi: "Dapur Umum & Ruang Makan Santri",
                detailLokasi: "Meja makan panjang, tempat cuci piring, dan galon air minum.",
                shift: "Ba'da Sarapan & Makan Sore",
                anggota: [
                    { nama: "Hafidz Abdurrahman", peran: "Ketua Kelompok" },
                    { nama: "Tariq Ziyad", peran: "Anggota" },
                    { nama: "Luthfi Hakim", peran: "Anggota" },
                    { nama: "Rendi Kurniawan", peran: "Anggota" }
                ],
                tugas: [
                    { id: "kam-1", teks: "Mengelap seluruh meja dan kursi ruang makan", selesai: false },
                    { id: "kam-2", teks: "Menyapu dan mengepel lantai ruang makan", selesai: false },
                    { id: "kam-3", teks: "Mengecek ketersediaan air galon minum santri", selesai: false },
                    { id: "kam-4", teks: "Merapikan rak piring dan gelas bersih", selesai: false },
                    { id: "kam-5", teks: "Mengosongkan tempat sampah sisa makanan", selesai: false }
                ]
            },
            jumat: {
                hari: "Jumat",
                icon: "🕌",
                kelompok: "Kelompok Khalid bin Walid (Jumat Bersih)",
                lokasi: "Aula Kajian, Perpustakaan & Taman",
                detailLokasi: "Ruang kelas/aula kitab, rak buku perpustakaan, dan taman.",
                shift: "Jumat Pagi (07.30 WIB)",
                anggota: [
                    { nama: "Yusuf Mansyur", peran: "Ketua Kelompok" },
                    { nama: "Bilal Rabah", peran: "Anggota" },
                    { nama: "Ibrahim Khalil", peran: "Anggota" },
                    { nama: "Azizul Hakim", peran: "Anggota" },
                    { nama: "Daffa Maulana", peran: "Anggota" }
                ],
                tugas: [
                    { id: "jum-1", teks: "Menyapu & mengepel lantai aula kajian kitab", selesai: false },
                    { id: "jum-2", teks: "Merapikan meja belajar dan papan tulis", selesai: false },
                    { id: "jum-3", teks: "Menata ulang kitab & buku di perpustakaan", selesai: false },
                    { id: "jum-4", teks: "Menyiram tanaman hias di taman sekitar aula", selesai: false }
                ]
            }
        };

        // State Aplikasi
        let piketData = JSON.parse(localStorage.getItem('smartPiketSantriData')) || JSON.parse(JSON.stringify(defaultPiketData));
        let activeDay = 'senin';
        let currentFilter = 'all'; // 'all' | 'pending' | 'done'

        // Simpan state ke localStorage
        function saveData() {
            try {
                localStorage.setItem('smartPiketSantriData', JSON.stringify(piketData));
            } catch (e) {
                console.warn('Penyimpanan lokal tidak tersedia:', e);
            }
        }

        // Inisialisasi aplikasi saat halaman dimuat
        window.onload = function() {
            // Deteksi hari ini secara otomatis jika Senin-Jumat
            const dayMap = { 1: 'senin', 2: 'selasa', 3: 'rabu', 4: 'kamis', 5: 'jumat' };
            const todayNum = new Date().getDay();
            if (dayMap[todayNum]) {
                activeDay = dayMap[todayNum];
            }
            renderAll();
        };

        // Render seluruh komponen UI
        function renderAll() {
            renderSidebarNav();
            renderGroupInfo();
            renderTasks();
            updateStats();
        }

        // 1. Render Navigasi Hari Senin - Jumat di Sidebar
        function renderSidebarNav() {
            const navContainer = document.getElementById('day-nav');
            navContainer.innerHTML = '';

            Object.keys(piketData).forEach(key => {
                const item = piketData[key];
                const isActive = key === activeDay;
                const doneCount = item.tugas.filter(t => t.selesai).length;
                const totalCount = item.tugas.length;
                const isAllDone = totalCount > 0 && doneCount === totalCount;

                const btn = document.createElement('button');
                btn.onclick = () => selectDay(key);
                btn.className = isActive
                    ? 'w-full flex items-center justify-between px-4 py-3.5 rounded-2xl bg-pastel-purpleDark text-white font-display font-bold text-sm shadow-clay-btn transition-all transform scale-[1.02]'
                    : 'w-full flex items-center justify-between px-4 py-3 rounded-2xl bg-white/60 hover:bg-white text-slate-600 font-display font-bold text-sm shadow-clay-sm transition-all';

                btn.innerHTML = `
                    <div class="flex items-center gap-2.5">
                        <span class="text-base">${item.icon}</span>
                        <span>${item.hari}</span>
                    </div>
                    <span class="text-[11px] px-2 py-0.5 rounded-full ${
                        isActive 
                            ? 'bg-white/25 text-white' 
                            : isAllDone 
                                ? 'bg-emerald-100 text-emerald-700' 
                                : 'bg-slate-100 text-slate-500'
                    }">
                        ${doneCount}/${totalCount}
                    </span>
                `;
                navContainer.appendChild(btn);
            });
        }

        // Pilih Hari
        function selectDay(dayKey) {
            activeDay = dayKey;
            renderAll();
        }

        // 2. Render Informasi Nama Kelompok, Lokasi Piket & Anggota
        function renderGroupInfo() {
            const current = piketData[activeDay];
            document.getElementById('badge-day').textContent = `Hari ${current.hari}`;
            document.getElementById('badge-shift').textContent = `⏰ ${current.shift}`;
            document.getElementById('group-name').textContent = current.kelompok;
            document.getElementById('group-location').textContent = current.lokasi;
            document.getElementById('group-area-detail').textContent = current.detailLokasi;
            document.getElementById('member-count').textContent = `${current.anggota.length} Santri`;
            document.getElementById('modal-day-name').textContent = current.hari;

            const memberListEl = document.getElementById('member-list');
            memberListEl.innerHTML = '';

            const avatarColors = ['bg-purple-100 text-purple-700', 'bg-emerald-100 text-emerald-700', 'bg-amber-100 text-amber-700', 'bg-sky-100 text-sky-700', 'bg-rose-100 text-rose-700'];

            current.anggota.forEach((member, idx) => {
                const initials = member.nama.split(' ').map(n => n[0]).slice(0, 2).join('');
                const colorClass = avatarColors[idx % avatarColors.length];
                const isLeader = member.peran.toLowerCase().includes('ketua');

                const li = document.createElement('li');
                li.className = 'flex items-center justify-between bg-cream-50/90 px-3.5 py-2.5 rounded-2xl border border-cream-200/60';
                li.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-xl ${colorClass} font-display font-extrabold text-xs flex items-center justify-center shadow-xs">
                            ${initials}
                        </div>
                        <span class="text-sm font-semibold text-slate-700">${member.nama}</span>
                    </div>
                    <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full ${isLeader ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-500'}">
                        ${member.peran}
                    </span>
                `;
                memberListEl.appendChild(li);
            });
        }

        // 3. Render Daftar Checklist Tugas
        function renderTasks() {
            const taskListEl = document.getElementById('task-list');
            const tasks = piketData[activeDay].tugas;
            taskListEl.innerHTML = '';

            const filteredTasks = tasks.filter(task => {
                if (currentFilter === 'done') return task.selesai;
                if (currentFilter === 'pending') return !task.selesai;
                return true;
            });

            if (filteredTasks.length === 0) {
                taskListEl.innerHTML = `
                    <div class="text-center py-10 px-4 bg-cream-50 rounded-2xl border border-dashed border-cream-200">
                        <div class="text-3xl mb-2">✨</div>
                        <p class="font-display font-bold text-slate-600 text-sm">Tidak ada tugas pada kategori ini</p>
                        <p class="text-xs text-slate-400 mt-1">Ubah filter tampilan atau tambahkan tugas baru di atas.</p>
                    </div>
                `;
                return;
            }

            filteredTasks.forEach(task => {
                const itemDiv = document.createElement('div');
                itemDiv.className = `group flex items-center justify-between gap-3 p-4 rounded-2xl border transition-all duration-200 cursor-pointer select-none ${
                    task.selesai 
                        ? 'bg-pastel-mint/35 border-emerald-200/70' 
                        : 'bg-cream-50/70 hover:bg-white border-cream-200 hover:shadow-clay-sm'
                }`;
                
                itemDiv.onclick = () => toggleTask(task.id);

                itemDiv.innerHTML = `
                    <div class="flex items-center gap-3.5 flex-1">
                        <!-- Custom Checkbox -->
                        <div class="w-6 h-6 rounded-lg flex items-center justify-center transition-all shrink-0 ${
                            task.selesai 
                                ? 'bg-emerald-500 text-white shadow-sm scale-105' 
                                : 'bg-white border-2 border-slate-300 group-hover:border-pastel-purpleDark'
                        }">
                            ${task.selesai ? `
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                            ` : ''}
                        </div>

                        <!-- Teks Tugas -->
                        <span class="text-sm font-medium leading-snug transition-all ${
                            task.selesai ? 'line-through text-slate-400' : 'text-slate-700'
                        }">
                            ${task.teks}
                        </span>
                    </div>

                    <div class="flex items-center gap-2 shrink-0">
                        <span class="text-[11px] font-bold px-2.5 py-1 rounded-full ${
                            task.selesai 
                                ? 'bg-emerald-100 text-emerald-700' 
                                : 'bg-amber-100 text-amber-700'
                        }">
                            ${task.selesai ? 'Selesai' : 'Belum'}
                        </span>
                        
                        <!-- Tombol Hapus Tugas -->
                        <button onclick="deleteTask(event, '${task.id}')" title="Hapus tugas"
                            class="opacity-60 hover:opacity-100 text-slate-400 hover:text-rose-500 p-1.5 rounded-lg hover:bg-rose-50 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>
                    </div>
                `;

                taskListEl.appendChild(itemDiv);
            });
        }

        // Toggle Status Selesai / Belum Selesai
        function toggleTask(taskId) {
            const tasks = piketData[activeDay].tugas;
            const target = tasks.find(t => t.id === taskId);
            if (target) {
                target.selesai = !target.selesai;
                saveData();
                renderAll();
                if (target.selesai) {
                    showToast('Tugas ditandai selesai! Alhamdulillah', '✅');
                }
            }
        }

        // Tambah Tugas Baru
        function addNewTask(event) {
            event.preventDefault();
            const input = document.getElementById('new-task-input');
            const text = input.value.trim();
            if (!text) return;

            const newTask = {
                id: `${activeDay}-${Date.now()}`,
                teks: text,
                selesai: false
            };

            piketData[activeDay].tugas.push(newTask);
            input.value = '';
            saveData();
            renderAll();
            showToast('Tugas piket baru ditambahkan', '📝');
        }

        // Hapus Tugas
        function deleteTask(event, taskId) {
            event.stopPropagation();
            piketData[activeDay].tugas = piketData[activeDay].tugas.filter(t => t.id !== taskId);
            saveData();
            renderAll();
            showToast('Tugas dihapus dari daftar', '🗑️');
        }

        // Set Filter Tampilan Tugas
        function setFilter(filterType) {
            currentFilter = filterType;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.className = 'filter-btn text-xs font-semibold px-3 py-1.5 rounded-lg text-slate-500 hover:text-slate-700 transition';
            });
            const activeBtn = document.getElementById(`filter-${filterType}`);
            activeBtn.className = 'filter-btn text-xs font-bold px-3 py-1.5 rounded-lg bg-white text-pastel-purpleDark shadow-sm transition';
            renderTasks();
        }

        // 4. Hitung & Perbarui Statistik Jumlah Tugas Selesai & Belum Selesai
        function updateStats() {
            const currentTasks = piketData[activeDay].tugas;
            const totalToday = currentTasks.length;
            const doneToday = currentTasks.filter(t => t.selesai).length;
            const pendingToday = totalToday - doneToday;
            const percentToday = totalToday === 0 ? 0 : Math.round((doneToday / totalToday) * 100);

            // Hitung total keseluruhan minggu ini (Senin-Jumat)
            let weeklyTotal = 0;
            let weeklyDone = 0;
            Object.values(piketData).forEach(dayObj => {
                weeklyTotal += dayObj.tugas.length;
                weeklyDone += dayObj.tugas.filter(t => t.selesai).length;
            });

            // Update DOM Statistik
            document.getElementById('stat-done').textContent = doneToday;
            document.getElementById('stat-done-sub').textContent = `Hari ${piketData[activeDay].hari}`;
            
            document.getElementById('stat-pending').textContent = pendingToday;
            document.getElementById('stat-pending-sub').textContent = pendingToday === 0 ? 'Semua beres!' : 'Perlu dikerjakan';
            
            document.getElementById('stat-percent').textContent = `${percentToday}%`;
            document.getElementById('stat-total-badge').textContent = `${doneToday}/${totalToday}`;
            document.getElementById('progress-bar').style.width = `${percentToday}%`;

            document.getElementById('stat-weekly').textContent = `${weeklyDone}/${weeklyTotal}`;

            // Update Kartu Apresiasi jika 100% selesai
            const celebTitle = document.getElementById('celebration-title');
            const celebDesc = document.getElementById('celebration-desc');
            const celebEmoji = document.getElementById('celebration-emoji');

            if (totalToday > 0 && doneToday === totalToday) {
                celebTitle.textContent = "MasyaAllah, Piket Tuntas! 🎉";
                celebDesc.textContent = `Seluruh tugas piket hari ${piketData[activeDay].hari} telah selesai dengan sangat baik.`;
                celebEmoji.textContent = "🌟";
            } else {
                celebTitle.textContent = "Semangat Piket! 💪";
                celebDesc.textContent = `Tersisa ${pendingToday} tugas lagi untuk menyelesaikan piket hari ${piketData[activeDay].hari}.`;
                celebEmoji.textContent = "🐰";
            }
        }

        // 5. Logika Modal Reset Checklist
        function openResetModal() {
            const modal = document.getElementById('reset-modal');
            const box = document.getElementById('reset-modal-box');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                box.classList.remove('scale-95', 'opacity-0');
                box.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeResetModal() {
            const modal = document.getElementById('reset-modal');
            const box = document.getElementById('reset-modal-box');
            box.classList.remove('scale-100', 'opacity-100');
            box.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }, 150);
        }

        function executeReset(scope) {
            if (scope === 'current') {
                piketData[activeDay].tugas.forEach(t => t.selesai = false);
                showToast(`Checklist hari ${piketData[activeDay].hari} telah di-reset`, '🔄');
            } else if (scope === 'all') {
                Object.keys(piketData).forEach(dayKey => {
                    piketData[dayKey].tugas.forEach(t => t.selesai = false);
                });
                showToast('Semua checklist Senin - Jumat telah di-reset', '🔄');
            }
            saveData();
            renderAll();
            closeResetModal();
        }

        // Tutup modal jika klik di luar area kartu modal
        document.getElementById('reset-modal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeResetModal();
            }
        });

        // Toast Notification Helper
        let toastTimeout;
        function showToast(message, icon = '✨') {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').textContent = message;
            document.getElementById('toast-icon').textContent = icon;

            toast.classList.remove('translate-y-20', 'opacity-0');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2600);
        }
    </script>
</body>
</html>
